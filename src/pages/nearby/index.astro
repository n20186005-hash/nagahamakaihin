---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';

const title = '伊豆多賀・長浜海浜公園の周辺散策｜四季の道と海の展望';
const description = '長浜海浜公園と合わせて歩きたい伊豆多賀の散策スポット。さくらの名所散策路「四季の道」の歴史、海の眺望、桜の見頃、交通と撮影ポイントを案内。';
const mapTrail = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('さくらの名所散策路 四季の道 熱海市上多賀');
const mapStation = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('伊豆多賀駅 静岡県熱海市');
const mapMarine = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('小山臨海公園 マリンタワー 熱海市下多賀');
const mapIzuTaga = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('伊豆多賀駅 静岡県熱海市上多賀');
const mapAjiro = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('網代漁港 静岡県熱海市網代');
const mapCastle = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('熱海城 静岡県熱海市熱海1993');
const places = [
  {name:'さくらの名所散策路（四季の道）',kind:'高台の桜と多賀湾の眺望',link:mapTrail,href:'/nearby/shiki-no-michi/',image:'/images/nearby/shiki-walk.jpg',description:'伊豆多賀駅と熱海高校を結ぶ高台の散策路。2017年に開通し、道沿いにアタミザクラやヒマラヤザクラが植えられています。',photo:'桜越しに海を見下ろす構図。開花状況と通行状況を見て撮影位置を選びましょう。'},
  {name:'小山臨海公園・マリンタワー',kind:'海沿いの公園と展望',link:mapMarine,href:'/nearby/koyama-rinkai-park/',image:'/images/nearby/koyama-park.jpg',description:'網代方面の公園。体育館、テニスコート、芝生広場があり、マリンタワー周辺から多賀湾を見渡せると紹介されています。',photo:'高い位置から湾と海岸線を入れた風景写真。展望施設の開放状況を事前に確認してください。'},
  {name:'伊豆多賀駅',kind:'桜と海への散策の起点',link:mapIzuTaga,href:'/nearby/izu-taga-station/',image:'/images/nearby/izu-taga-station.webp',description:'JR伊東線の駅。駅前の桜、斜面に建つ駅舎、海岸へ下る桜坂を観察でき、四季の道へ向かう出発点にもなります。',photo:'駅舎と階段、ホーム周辺の緑を撮影。列車や通行人の動線を妨げないようにしましょう。'},
  {name:'網代漁港',kind:'漁船と港町の歴史',link:mapAjiro,href:'/nearby/ajiro-fishing-port/',image:'/images/nearby/ajiro-harbor.webp',description:'江戸時代の廻船の往来と現在の漁業が重なる、南熱海の港。現役の漁業施設なので公共の通行可能な場所から眺めます。',photo:'係留船と背後の山並みを一緒に。岸壁の作業区域には入らないでください。'},
  {name:'熱海城',kind:'昭和の観光天守と展望',link:mapCastle,href:'/nearby/atami-castle/',image:'/images/nearby/atami-castle.webp',description:'1959年築の観光天守。桃山風の外観と相模湾の展望が魅力で、長浜の海岸散策とは別の移動で訪ねる高台の施設です。',photo:'城の屋根と海岸線を同じ画角に。展望階からの撮影は館内のルールを確認してください。'}
];
---
<BaseLayout title={title} description={description}>
  <PageHero eyebrow="EXPLORE IZU TAGA" title="伊豆多賀の海辺と高台を歩く" text="長浜海浜公園の砂浜に、高台の桜並木や湾を見晴らす公園を組み合わせる散策案内。歩く場所と移動距離の違いを確認して、自分のペースで巡りましょう。" icon="map-pin" image="/images/nagahama-calm.webp" imageAlt="散策の起点となる長浜海浜公園の海岸" />
  <section class="section-space"><div class="container-site"><SectionHeading eyebrow="NEARBY PLACES" title="周辺で訪ねたい五つの場所" text="長浜の砂浜とは違う景色を楽しめる、実在する散策・展望スポットです。各リンクはそれぞれの場所名でGoogleマップ検索を開きます。距離のある場所は別の訪問枠で計画してください。" />
    <div class="mt-9 grid gap-6 md:grid-cols-2">{places.map((place,index) => <article class="soft-card overflow-hidden"><img src={place.image} alt={`${place.name}の実景`} width="600" height="450" loading="lazy" class="aspect-[4/3] w-full object-cover" /><div class="p-7 sm:p-9"><p class="text-xs font-bold tracking-wider text-sea-dark">0{index+1} · {place.kind}</p><h2 class="mt-3 font-serif text-2xl font-semibold">{place.name}</h2><p class="mt-5 text-sm leading-8 text-ink-soft">{place.description}</p><h3 class="mt-6 font-bold">写真を撮るなら</h3><p class="mt-2 text-sm leading-7 text-ink-soft">{place.photo}</p><a class="button-secondary mt-7" href={place.href}>景点の詳しいガイドを見る →</a><a class="mt-5 block text-sm font-bold text-sea-dark underline" href={place.link} target="_blank" rel="noopener noreferrer">Googleマップ ↗</a></div></article>)}</div>
  </div></section>
  <section class="section-space bg-paper"><div class="container-site grid gap-10 lg:grid-cols-2"><div><SectionHeading eyebrow="WALKING ROUTE" title="伊豆多賀駅から四季の道へ" text="桜並木を中心に歩くなら、伊豆多賀駅を出発点にして高台の散策路を訪ねるルートがおすすめです。長浜海浜公園からは別の上り坂移動になります。" />
    <ol class="mt-8 grid gap-4">{[
      ['伊豆多賀駅','まず駅周辺で当日の運行と天候を確認します。'],
      ['四季の道へ','高台方向へ進み、散策路の入口と案内標識を確認します。坂道があるので歩きやすい靴を。'],
      ['海を見渡す場所で休憩','桜や多賀湾の眺めを楽しみ、同じ道を戻るなど無理のない行程を選びます。'],
      ['長浜海浜公園へ','時間と体力に余裕があれば海側へ下り、砂浜と芝生広場を散策します。']
    ].map(([heading,body],index) => <li class="flex gap-4 rounded-2xl bg-white p-5"><span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-ink text-sm text-white">{index+1}</span><div><h3 class="font-bold">{heading}</h3><p class="mt-2 text-sm leading-7 text-ink-soft">{body}</p></div></li>)}</ol>
    <a class="button-secondary mt-7" href={mapStation} target="_blank" rel="noopener noreferrer">伊豆多賀駅の場所を見る ↗</a></div>
    <div><img src="/images/nagahama-hero.webp" width="1200" height="900" loading="lazy" alt="長浜海浜公園の海辺の風景" class="aspect-[4/3] w-full rounded-[2rem] object-cover shadow-soft" /><p class="mt-3 text-xs text-ink-soft">写真は長浜海浜公園の海岸風景。四季の道の現地写真ではありません。</p><div class="mt-8 rounded-3xl bg-sea-pale p-7"><h2 class="font-serif text-xl font-semibold">桜の季節と散策の注意</h2><p class="mt-4 text-sm leading-8">アタミザクラは例年1月から2月頃が見どころですが、年ごとの開花状況で変わります。散策路は高低差があり、雨の日や日没後は足元に注意してください。小山臨海公園は四季の道とは別方面のため、同じ徒歩コースに無理に組み込まないでください。</p></div></div></div></section>
  <section class="section-space"><div class="container-site"><SectionHeading eyebrow="BACKGROUND" title="海と桜を結ぶ散策路の成り立ち" text="四季の道はもともと熱海高校への通学や災害時の避難にも役立つ道として整備され、2017年3月に開通しました。高台の花と海の眺めが魅力です。" />
    <div class="mt-8 rounded-3xl border border-ink/10 p-7"><h2 class="font-serif text-xl font-semibold">公式情報と確認先</h2><ul class="mt-4 list-disc space-y-3 pl-5 text-sm leading-7 text-ink-soft"><li><a class="underline" href="https://www.city.atami.lg.jp/hana/1003681/1003682/1003686.html" target="_blank" rel="noopener noreferrer">熱海市・さくらの名所散策路 あたみ桜 ↗</a></li><li><a class="underline" href="https://www.city.atami.lg.jp/mayor/diary/1002250/1004297.html" target="_blank" rel="noopener noreferrer">熱海市・散策路の開通記録 ↗</a></li><li><a class="underline" href="https://ajirospa.com/experience-facility/%E5%B0%8F%E5%B1%B1%E8%87%A8%E6%B5%B7%E5%85%AC%E5%9C%92/" target="_blank" rel="noopener noreferrer">網代温泉観光協会・小山臨海公園 ↗</a></li></ul><p class="mt-4 text-sm text-ink-soft">資料参照日：2026年11月19日。開花・施設利用・経路は現地の案内をご確認ください。</p><p class="mt-6 text-sm"><a class="font-bold text-sea-dark underline" href="/access/">長浜へのアクセス →</a>　<a class="font-bold text-sea-dark underline" href="/beach/">海水浴場 →</a>　<a class="font-bold text-sea-dark underline" href="/parking/">駐車場 →</a></p></div>
  </div></section>
</BaseLayout>
