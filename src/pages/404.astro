---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---
<BaseLayout title="ページが見つかりません" description="お探しのページは見つかりませんでした。" noindex={true}>
  <section class="grid min-h-[65vh] place-items-center px-4 py-20">
    <div class="max-w-xl text-center">
      <span class="mx-auto grid h-20 w-20 place-items-center rounded-full bg-sea-pale text-sea-dark"><Icon name="waves" size={38} /></span>
      <p class="mt-7 font-serif text-7xl font-semibold text-ink/12">404</p>
      <h1 class="mt-2 font-serif text-3xl font-semibold">ページが見つかりません</h1>
      <p class="mt-5 text-sm leading-8 text-ink-soft">URLが変更されたか、ページが削除された可能性があります。トップページから長浜海浜公園の情報をご覧ください。</p>
      <a href="/" class="button-primary mt-8">トップへ戻る <Icon name="arrow" size={18} /></a>
    </div>
  </section>
</BaseLayout>
