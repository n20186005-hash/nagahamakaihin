---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import StatusBar from '@/components/StatusBar.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FacilityGrid from '@/components/FacilityGrid.astro';
import PlanSwitcher from '@/components/PlanSwitcher.astro';
import AccessDiagram from '@/components/AccessDiagram.astro';
import FaqList from '@/components/FaqList.astro';
import Icon from '@/components/Icon.astro';
import data from '@/data/site.json';

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Park'],
  name: '長浜海浜公園',
  alternateName: ['長浜海水浴場', 'うみえ〜る長浜'],
  description: data.site.description,
  url: data.site.url,
  image: [`${data.site.url}/images/og-nagahama.jpg`],
  address: {
    '@type': 'PostalAddress',
    postalCode: '413-0101',
    addressRegion: '静岡県',
    addressLocality: '熱海市',
    streetAddress: '上多賀地先',
    addressCountry: 'JP'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: data.site.latitude,
    longitude: data.site.longitude
  },
  isAccessibleForFree: true,
  publicAccess: true,
  telephone: data.site.phone
};
---
<BaseLayout schema={placeSchema}>
  <Hero />
  <StatusBar />

  <section class="section-space pt-14">
    <div class="container-site">
      <SectionHeading eyebrow="WHY NAGAHAMA" title="海水浴だけではない、海辺の公園。" text="長浜海浜公園は、砂浜と芝生、遊具、休憩施設がひとつにつながった場所。夏の海はもちろん、春や秋の散歩、子どもとの外遊びにも向いています。" />
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {data.features.map((feature, index) => (
          <article class="soft-card relative overflow-hidden p-6 sm:p-7">
            <span class="absolute right-4 top-1 font-serif text-7xl text-ink/[0.035]">0{index + 1}</span>
            <span class="grid h-12 w-12 place-items-center rounded-full bg-sea-pale text-sea-dark"><Icon name={feature.icon} size={24} /></span>
            <h3 class="mt-6 font-serif text-xl font-semibold">{feature.title}</h3>
            <p class="mt-3 text-sm leading-7 text-ink-soft">{feature.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space overflow-hidden bg-paper">
    <div class="container-site grid items-center gap-10 lg:grid-cols-[1.05fr_.95fr]">
      <figure class="relative lg:order-2">
        <div class="absolute -right-5 -top-5 h-full w-full rounded-[2.2rem] border border-coral/35"></div>
        <img src="/images/nagahama-calm.webp" width="1200" height="900" loading="lazy" alt="長浜海水浴場の砂浜と海、背後に見える山と街並み" class="relative aspect-[4/3] w-full rounded-[2.2rem] object-cover shadow-soft" />
        <figcaption class="absolute bottom-4 left-4 rounded-full bg-ink/70 px-4 py-2 text-xs text-white backdrop-blur">波の穏やかな南熱海の海辺</figcaption>
      </figure>
      <div class="lg:order-1">
        <SectionHeading eyebrow="UMIÈRE NAGAHAMA" title="海を眺めながら、ひと休み。" text="休憩施設「うみえ〜る長浜」を中心に、トイレ、足洗い場、芝生広場、ベンチなどが整っています。夏季には更衣室やシャワー、ロッカー、飲食設備も利用できます。" />
        <div class="mt-8">
          <FacilityGrid />
        </div>
        <a href="/beach/" class="button-secondary mt-7">設備と夏季ルールを見る <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="container-site">
      <SectionHeading eyebrow="SLOW ITINERARY" title="予定を詰めすぎない、長浜の過ごし方。" text="子どもと遊ぶ日、海に入る日、ただ散歩する日。目的に合わせた半日の流れを選べます。" />
      <PlanSwitcher />
    </div>
  </section>

  <section class="section-space bg-ink text-white">
    <div class="container-site grid gap-10 lg:grid-cols-[.82fr_1.18fr] lg:items-center">
      <div>
        <p class="eyebrow text-sea">ACCESS</p>
        <h2 class="section-title mt-4">電車でも、車でも。<br />海はすぐそこ。</h2>
        <p class="mt-5 max-w-xl text-base leading-8 text-white/70">JR伊豆多賀駅からは徒歩約7〜10分。熱海駅からのバスは「長浜」下車すぐ。荷物や同行者に合わせて移動方法を選べます。</p>
        <div class="mt-7 grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
          {data.access.map((item) => (
            <div class="flex items-center gap-4 rounded-2xl border border-white/12 bg-white/[0.06] p-4">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white/10 text-sea"><Icon name={item.icon} size={20} /></span>
              <div><p class="text-xs font-bold text-white/45">{item.mode}</p><p class="mt-1 text-sm font-bold">{item.headline}</p></div>
            </div>
          ))}
        </div>
        <a href="/access/" class="button-primary mt-7 bg-white text-ink shadow-none">詳しいアクセス <Icon name="arrow" size={18} /></a>
      </div>
      <div class="[&_div.soft-card]:border-white/10 [&_div.soft-card]:shadow-none"><AccessDiagram /></div>
    </div>
  </section>

  <section class="section-space paper-pattern">
    <div class="container-site">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <SectionHeading eyebrow="LOCAL LUNCH" title="海のあと、何を食べよう。" text="歩いて行ける範囲に、海鮮、そば、ラーメン、スイーツがあります。営業時間は変わりやすいため、当日の営業確認がおすすめです。" />
        <a href="/food/" class="button-secondary shrink-0">周辺ランチ一覧 <Icon name="arrow" size={18} /></a>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {data.restaurants.slice(0, 3).map((restaurant) => (
          <article class="soft-card flex flex-col p-6">
            <div class="flex items-start justify-between gap-4">
              <span class="grid h-12 w-12 place-items-center rounded-full bg-coral-pale text-coral"><Icon name={restaurant.icon} size={23} /></span>
              <span class="rounded-full bg-sand px-3 py-1.5 text-xs font-bold text-ink-soft">{restaurant.distance}</span>
            </div>
            <p class="mt-5 text-xs font-bold tracking-wider text-sea-dark">{restaurant.category}</p>
            <h3 class="mt-2 font-serif text-xl font-semibold">{restaurant.name}</h3>
            <p class="mt-3 flex-1 text-sm leading-7 text-ink-soft">{restaurant.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space bg-paper">
    <div class="container-site grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <SectionHeading eyebrow="SEASONAL EVENTS" title="海辺の季節を楽しむ。" text="夏の花火、春と秋の特設市。長浜は、季節ごとに地元の暮らしが見える場所でもあります。" />
        <a href="/events/" class="button-secondary mt-7">年間イベントを見る <Icon name="arrow" size={18} /></a>
      </div>
      <div class="grid gap-3">
        {data.events.slice(0, 3).map((event) => (
          <article class="soft-card grid gap-4 p-5 sm:grid-cols-[9rem_1fr] sm:p-6">
            <div class="rounded-2xl bg-sea-pale p-4 text-center">
              <p class="text-xs font-bold tracking-wider text-sea-dark">{event.type}</p>
              <p class="mt-2 font-serif text-lg font-semibold">{event.date}</p>
            </div>
            <div>
              <h3 class="font-serif text-xl font-semibold">{event.title}</h3>
              <p class="mt-2 text-sm leading-7 text-ink-soft">{event.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="container-site max-w-4xl">
      <SectionHeading eyebrow="FAQ" title="お出かけ前によくある質問。" align="center" />
      <div class="mt-9"><FaqList limit={5} /></div>
      <div class="mt-7 text-center"><a href="/faq/" class="button-secondary">すべての質問を見る <Icon name="arrow" size={18} /></a></div>
    </div>
  </section>

  <section class="pb-16 sm:pb-24">
    <div class="container-site overflow-hidden rounded-[2rem] bg-coral-pale p-8 sm:p-12">
      <div class="grid items-center gap-8 md:grid-cols-[1fr_auto]">
        <div>
          <p class="eyebrow text-coral">BEFORE YOU GO</p>
          <h2 class="mt-4 font-serif text-3xl font-semibold">海へ行く前に、アクセスと持ち物を確認。</h2>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-ink-soft">夏季は現金が必要な設備があります。日差し対策、水分、着替え、100円・500円硬貨を準備しておくと安心です。</p>
        </div>
        <a href="/access/" class="button-primary shrink-0">アクセスを見る <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
</BaseLayout>
