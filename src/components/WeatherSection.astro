    function refresh() {
      fetch('/api/weather')
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => { if (d && root) root.innerHTML = renderWeatherHtml(d); })
        .catch(() => {});
    }
    refresh();
  })();
</script>
