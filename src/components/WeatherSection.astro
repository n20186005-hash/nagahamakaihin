        html += '<p class="mt-1 text-[10px] text-sea-dark">' + Math.round(day.pop) + '%</p>';
        html += '</div>';
      });
      html += '</div></div></div>';
      const a = d.advice || { alert: [], risk: [], outfit: [], plan: [], items: [] };
