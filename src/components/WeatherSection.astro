    const root = document.getElementById('weather-body');
    function renderWeatherHtml(d) {
      const wmo = {
        0: ['晴れ', 'sun'], 1: ['大体晴れ', 'sun'], 2: ['一部曇り', 'cloud'], 3: ['曇り', 'cloud'],
        45: ['霧', 'fog'], 46: ['霧', 'fog'], 48: ['霧', 'fog'],
        51: ['霧雨', 'rain'], 53: ['霧雨', 'rain'], 55: ['霧雨', 'rain'], 56: ['霧雨', 'rain'], 57: ['霧雨', 'rain'],
        61: ['雨', 'rain'], 63: ['雨', 'rain'], 65: ['雨', 'rain'], 66: ['雨', 'rain'], 67: ['雨', 'rain'],
        71: ['雪', 'snow'], 73: ['雪', 'snow'], 75: ['雪', 'snow'], 77: ['雪', 'snow'],
        80: ['にわか雨', 'rain'], 81: ['にわか雨', 'rain'], 82: ['にわか雨', 'rain'],
        85: ['雪', 'snow'], 86: ['雪', 'snow'],
        95: ['雷雨', 'rain'], 96: ['雷雨', 'rain'], 99: ['雷雨', 'rain'],
      };
      const wmoInfo = (code) => wmo[code] || ['その他', 'cloud'];
      const beaufort = (kmh) => {
        const t = [1, 6, 12, 20, 29, 39, 50, 62, 75, 89, 103, 118];
        let b = 0; for (const x of t) { if (kmh >= x) b += 1; else break; } return b;
      };
      const dirJa = (deg) => {
        const a = ['北', '北北東', '北東', '東北東', '東', '東南東', '南東', '南南東', '南', '南南西', '南西', '西南西', '西', '西北西', '北西', '北北西'];
        return a[Math.round(deg / 22.5) % 16];
      };
      const glyph = (kind) => {
        if (kind === 'sun') return '<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>';
        if (kind === 'cloud') return '<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a4 4 0 0 1 0-8 5 5 0 0 1 9.6-1.3A3.5 3.5 0 0 1 17 18H7Z"/></svg>';
        if (kind === 'rain') return '<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 15a4 4 0 0 1 0-8 5 5 0 0 1 9.6-1.3A3.5 3.5 0 0 1 17 15"/><path d="M8 18l-1 2M12 18l-1 2M16 18l-1 2"/></svg>';
        if (kind === 'snow') return '<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 15a4 4 0 0 1 0-8 5 5 0 0 1 9.6-1.3A3.5 3.5 0 0 1 17 15"/><path d="M9 19h.01M12 21h.01M15 19h.01"/></svg>';
        if (kind === 'wind') return '<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h11a3 3 0 1 0-3-3M3 16h15a3 3 0 1 1-3 3"/></svg>';
        return '<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h12M4 12h16M4 16h10"/></svg>';
      };
      const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const c = d.current;
      const cur = wmoInfo(c.code);
      const b = beaufort(c.windKmh);
      const pop = (d.daily[0] && d.daily[0].pop) || 0;
      const uv = (d.daily[0] && d.daily[0].uv) || 0;
      let html = '<div class="grid gap-6 lg:grid-cols-[1.1fr_1.4fr]">';
      html += '<div class="rounded-[1.75rem] bg-ink text-white p-7 sm:p-9">';
      html += '<div class="flex items-start justify-between gap-4"><div><p class="text-xs font-bold tracking-[0.16em] text-sea">現在の天気</p>';
      html += '<p class="mt-3 flex items-end gap-3"><span class="font-serif text-5xl font-semibold">' + Math.round(c.temp) + '°</span><span class="mb-1 text-sm text-white/70">体感 ' + Math.round(c.feels) + '°</span></p>';
      html += '<p class="mt-2 text-lg font-bold">' + esc(cur[0]) + '</p></div><span class="text-sea">' + glyph(cur[1]) + '</span></div>';
      html += '<div class="mt-6 grid grid-cols-2 gap-4 text-sm">';
      html += '<div><p class="text-white/50">風力</p><p class="mt-1 font-bold">' + b + '級（' + Math.round(c.windKmh) + ' km/h）・' + dirJa(c.windDir) + '</p></div>';
      html += '<div><p class="text-white/50">湿度</p><p class="mt-1 font-bold">' + Math.round(c.humidity) + '%</p></div>';
      html += '<div><p class="text-white/50">降水確率（本日）</p><p class="mt-1 font-bold">' + Math.round(pop) + '%</p></div>';
      html += '<div><p class="text-white/50">紫外線（本日最大）</p><p class="mt-1 font-bold">' + Math.round(uv) + '</p></div>';
      html += '</div></div>';
      html += '<div class="rounded-[1.75rem] bg-paper p-7 sm:p-9">';
      html += '<p class="text-xs font-bold tracking-[0.16em] text-sea-dark">今後7日間の予報</p>';
