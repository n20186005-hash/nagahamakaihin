---
import Icon from './Icon.astro';
import data from '@/data/site.json';
interface Props { limit?: number; }
const { limit } = Astro.props;
const items = typeof limit === 'number' ? data.faqs.slice(0, limit) : data.faqs;
---
<div class="divide-y divide-ink/10 overflow-hidden rounded-[1.5rem] border border-ink/10 bg-paper shadow-card">
  {items.map((faq, index) => (
    <details class="group" open={index === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-5 px-5 py-5 font-bold sm:px-7 sm:py-6">
        <span class="flex items-start gap-4">
          <span class="mt-0.5 font-serif text-lg text-coral">Q.</span>
          <span>{faq.question}</span>
        </span>
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-sea-pale text-sea-dark transition-transform group-open:rotate-90"><Icon name="chevron" size={16} /></span>
      </summary>
      <div class="grid grid-cols-[auto_1fr] gap-4 px-5 pb-6 sm:px-7 sm:pb-7">
        <span class="font-serif text-lg font-semibold text-sea-dark">A.</span>
        <p class="text-sm leading-8 text-ink-soft">{faq.answer}</p>
      </div>
    </details>
  ))}
</div>
