---
import Icon from './Icon.astro';
import data from '@/data/site.json';
---
<div class="mt-10">
  <div class="flex flex-wrap gap-2" role="tablist" aria-label="おすすめの過ごし方">
    {data.plans.map((plan, index) => (
      <button type="button" role="tab" id={`tab-${plan.id}`} aria-controls={`panel-${plan.id}`} aria-selected={index === 0 ? 'true' : 'false'} data-plan-tab={plan.id} class:list={["inline-flex items-center gap-2 rounded-full border px-4 py-3 text-sm font-bold transition-colors", index === 0 ? 'border-ink bg-ink text-white' : 'border-ink/15 bg-paper text-ink hover:bg-sea-pale']}>
        <Icon name={plan.icon} size={18} /> {plan.label}
      </button>
    ))}
  </div>

  <div class="mt-5">
    {data.plans.map((plan, index) => (
      <section id={`panel-${plan.id}`} role="tabpanel" aria-labelledby={`tab-${plan.id}`} data-plan-panel={plan.id} class:list={["soft-card overflow-hidden", index !== 0 && 'hidden']}>
        <div class="grid lg:grid-cols-[.72fr_1.28fr]">
          <div class="sea-pattern p-7 sm:p-9">
            <span class="grid h-14 w-14 place-items-center rounded-full bg-paper text-sea-dark shadow-card"><Icon name={plan.icon} size={26} /></span>
            <h3 class="mt-6 font-serif text-2xl font-semibold">{plan.label}</h3>
            <p class="mt-3 inline-flex items-center gap-2 text-sm font-bold text-ink-soft"><Icon name="clock" size={17} /> {plan.time}</p>
            <p class="body-copy mt-5 text-sm">予定を詰め込みすぎず、海辺の時間をゆっくり残したプランです。</p>
          </div>
          <ol class="grid p-7 sm:p-9">
            {plan.items.map((item, itemIndex) => (
              <li class:list={["relative grid grid-cols-[4.3rem_1fr] gap-4 pb-7", itemIndex === plan.items.length - 1 && 'pb-0']}>
                {itemIndex !== plan.items.length - 1 && <span class="absolute left-[2.1rem] top-8 h-[calc(100%_-_1.2rem)] w-px bg-ink/12"></span>}
                <div class="relative z-10 flex h-9 items-center justify-center rounded-full bg-coral-pale text-xs font-bold text-coral">{item.time}</div>
                <div>
                  <h4 class="font-bold">{item.title}</h4>
                  <p class="mt-1 text-sm leading-7 text-ink-soft">{item.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    ))}
  </div>
</div>
<script is:inline>
  const tabs = [...document.querySelectorAll('[data-plan-tab]')];
  const panels = [...document.querySelectorAll('[data-plan-panel]')];
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.getAttribute('data-plan-tab');
      tabs.forEach((button) => {
        const active = button === tab;
        button.setAttribute('aria-selected', String(active));
        button.classList.toggle('bg-ink', active);
        button.classList.toggle('text-white', active);
        button.classList.toggle('border-ink', active);
        button.classList.toggle('bg-paper', !active);
        button.classList.toggle('text-ink', !active);
        button.classList.toggle('border-ink/15', !active);
      });
      panels.forEach((panel) => panel.classList.toggle('hidden', panel.getAttribute('data-plan-panel') !== id));
    });
  });
</script>
